{
  "name": "astrotpv",
  "productName": "AstroTPV",
  "version": "1.1.1",
  "description": "TPV para bares y tiendas: cobros, mesas, stock, cierre de caja y tickets. Funciona sin internet.",
  "main": "electron/main.js",
  "author": "AstroSoftwareMoon",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js 8080",
    "test": "node --test tests/core.test.js",
    "test:e2e": "node tests/e2e.js",
    "icons": "node scripts/icons.js",
    "screenshots": "node scripts/screenshots.js",
    "build:web": "node scripts/build-web.js",
    "desktop": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.astrosoftwaremoon.astrotpv",
    "productName": "AstroTPV",
    "artifactName": "AstroTPV-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "index.html", "manifest.webmanifest", "sw.js",
      "css/**", "js/**", "icons/**", "fonts/**", "electron/**"
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }], "icon": "icons/icon-512.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "AstroTPV" },
    "portable": { "artifactName": "AstroTPV-${version}-portable.${ext}" },
    "linux": { "target": ["AppImage", "deb"], "category": "Office", "icon": "icons/icon-512.png", "maintainer": "AstroSoftwareMoon" },
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "category": "public.app-category.business", "icon": "icons/icon-1024.png" }
  }
}
